# The updates module: asks the website for the plugin's latest version and tells the user when
# theirs is older. Needs no other module here, so a plugin without activation can have it.
#
# Usage (from the top-level CMakeLists.txt, AFTER juce_add_plugin):
#     include(${SampleRealm-Modules_SOURCE_DIR}/cmake/Updates.cmake)
#     add_plugin_updates(${PROJECT_NAME})
#
# UPDATE_URL is the plugin's environment variable: its page on the website, as
# https://example.com/plugins/example. Unset, the plugin never asks and shows nothing. It is remembered
# between configures, until it is taken out of the plugin's .env.

include_guard(GLOBAL)

cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH modulesRepoDir)

juce_add_module("${modulesRepoDir}/updates")

function(add_plugin_updates pluginTarget)
    string(STRIP "$ENV{UPDATE_URL}" updateUrlFromEnvironment)

    if(updateUrlFromEnvironment)
        # Plain http only for a site run on this machine
        if(NOT updateUrlFromEnvironment MATCHES "^(https://|http://localhost(:[0-9]+)?/)[A-Za-z0-9./_-]+$" OR updateUrlFromEnvironment MATCHES "/$")
            message(FATAL_ERROR "updates: UPDATE_URL is the plugin's page on the website, as https://example.com/plugins/example, not: ${updateUrlFromEnvironment}")
        endif()

        # Kept so a reconfigure from a shell without the variable asks the same page
        set(UPDATE_URL "${updateUrlFromEnvironment}" CACHE INTERNAL "The plugin's page last configured with")
    elseif(EXISTS "${CMAKE_SOURCE_DIR}/.env")
        file(STRINGS "${CMAKE_SOURCE_DIR}/.env" updateUrlInDotEnv REGEX "UPDATE_URL=[\"']?h")

        if(updateUrlInDotEnv AND NOT UPDATE_URL)
            message(FATAL_ERROR "updates: there is a .env with UPDATE_URL but it isn't set. Run `source .env`, then configure again")
        elseif(NOT updateUrlInDotEnv AND UPDATE_URL)
            message(STATUS "updates: UPDATE_URL is gone from .env, so ${UPDATE_URL} is forgotten")
            unset(UPDATE_URL CACHE)
        endif()
    endif()

    foreach(name IN ITEMS COMPANY_NAME PRODUCT_NAME)
        get_target_property(${name} ${pluginTarget} JUCE_${name})

        if(NOT ${name} OR ${name} MATCHES "[^ -~]|[\"\\\\/:*?<>|]")
            message(FATAL_ERROR "updates: ${name} names the file the check is kept in, so it must be plain ASCII without any of \" \\ / : * ? < > | : ${${name}}")
        endif()
    endforeach()

    if(UPDATE_URL)
        message(STATUS "updates: asking ${UPDATE_URL}/version")
    else()
        message(STATUS "updates: UPDATE_URL isn't set, so the plugin never asks")
    endif()

    set(generatedDir "${CMAKE_CURRENT_BINARY_DIR}/updates")

    file(CONFIGURE OUTPUT "${generatedDir}/UpdateBuildConfig.h" @ONLY CONTENT
"// Generated by cmake/Updates.cmake from COMPANY_NAME, PRODUCT_NAME and the UPDATE_URL environment variable
namespace updates::config
{
    inline constexpr std::string_view companyName { \"@COMPANY_NAME@\" };
    inline constexpr std::string_view productName { \"@PRODUCT_NAME@\" };
    inline constexpr std::string_view updateUrl { \"@UPDATE_URL@\" };
}
")

    target_include_directories(${pluginTarget} PRIVATE "${generatedDir}")
    target_link_libraries(${pluginTarget} PRIVATE updates)
endfunction()
